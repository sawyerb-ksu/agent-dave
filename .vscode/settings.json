// VS Code settings for this folder only. Setup also opens it in its own profile, "DAVE",
// with no extensions, so the workshop looks the same on every machine.
{
  // DAVE is the AI here: turn off VS Code's built-in chat and keep its sidebar closed.
  // Delete these two lines to bring them back in this folder.
  "chat.disableAIFeatures": true,
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // Start on the files, without the Welcome tab or extension suggestions.
  "workbench.startupEditor": "none",
  "extensions.ignoreRecommendations": true,

  // Setup opens READY.md when it finishes; show it as a page, not as Markdown source.
  "workbench.editorAssociations": { "READY.md": "vscode.markdown.preview.editor" }
}
